{
  "name": "turntrail-workspace",
  "private": true,
  "version": "0.18.0",
  "description": "Vendor-neutral handoff layer for continuing developer agent sessions across Codex, Claude, and other tools.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.js packages/cli/test/*.test.js packages/vscode/test/*.test.cjs",
    "test:vscode-integration": "node scripts/test-vscode-integration.mjs",
    "lint": "node scripts/check-syntax.mjs && node scripts/check-webview-scripts.mjs && node scripts/check-packages.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "package:vscode": "node scripts/package-vscode.mjs",
    "marketing:fixture": "node scripts/create-marketing-fixture.mjs",
    "marketing:capture": "node scripts/capture-marketplace-screenshots.mjs",
    "marketing:video:capture": "node scripts/capture-live-demo.mjs",
    "marketing:video:narrate": "node scripts/generate-demo-narration.mjs",
    "marketing:video:render": "node scripts/render-short-demo.mjs",
    "marketing:video": "npm run marketing:video:capture && npm run marketing:video:narrate && npm run marketing:video:render"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "chrome-remote-interface": "^0.33.3"
  }
}
