    "configuration": {
      "title": "Turntrail",
      "properties": {
        "turntrail.maxExportChars": {
          "type": "number",
          "default": 120000,
          "description": "Character budget for the transcript embedded in a handoff. Receiving agents refuse or silently truncate oversized files, so an unbounded handoff delivers less than a budgeted one. User turns are reserved first, then the most recent remaining turns fill the budget; anything dropped is reported in the handoff header. 0 disables clipping."
        },
        "turntrail.sinceLastExport": {
          "type": "boolean",
          "default": false,
          "description": "Send only what the receiving agent has not seen. Its watermark is its own last turn or the last handoff aimed at it, whichever is later, so a round trip delivers just the other agent's work and never re-sends an agent its own history. Leave this off if you paste handoffs into fresh sessions, which have no memory of what an earlier handoff delivered."
        },
        "turntrail.dedupeTurns": {
          "type": "boolean",
          "default": true,
          "description": "Collapse consecutive duplicate turns. Native logs (e.g. Codex) record each message under several event types, producing 2-3 identical copies; this removes the repeats."
        },
        "turntrail.toolMaxChars": {
          "type": "number",
          "default": 2000,
          "description": "Truncate tool-output turns longer than this many characters (keeping head and tail). 0 disables truncation. Tool outputs like git diffs and directory listings dominate handoff size."
        },
        "turntrail.systemMaxChars": {
          "type": "number",
          "default": 800,
          "description": "Truncate system turns (e.g. repeated turn-context blobs) longer than this many characters. 0 disables truncation."
        },
        "turntrail.snapshotDiffMaxChars": {
          "type": "number",
          "default": 4000,
          "description": "How much of the uncommitted diff (staged and unstaged, vs HEAD) to include in the handoff. A handoff taken mid-edit is exactly when this matters. 0 omits the diff body; the file-level stat is still shown."
        },
        "turntrail.keepExports": {
          "type": "number",
          "default": 10,
          "description": "How many past handoff files to keep in .turntrail/exports. Older ones are deleted after each export. 0 keeps all of them."
        },
        "turntrail.openHandoffDocument": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated handoff markdown document after export."
        },
        "turntrail.claudeUri": {
          "type": "string",
          "scope": "application",
          "default": "vscode://anthropic.claude-code/open",
          "description": "Optional application-level URI used to open Claude Code. Only the current editor scheme with anthropic.claude-code/open is accepted."
        },
        "turntrail.allowExternalClaudeUri": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Allow Turntrail to open the validated Claude extension URI using the current editor's URI scheme."
        },
        "turntrail.claudeOpenCommand": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Optional application-level installed command used to open or focus Claude. Unrelated and destructive command ids are rejected."
        },
        "turntrail.codexOpenCommand": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Optional application-level installed command used to open or focus Codex. Unrelated and destructive command ids are rejected."
        },
        "turntrail.alwaysUseLatestSession": {
          "type": "boolean",
          "default": false,
          "description": "When several agent sessions were started in this workspace, use the most recently active one without asking. Off by default: sessions in one folder are not interchangeable, and the most recently touched is often not the one worth continuing."
        },
        "turntrail.accountMaintenance.enabled": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Periodically refresh due managed OAuth credentials and fetch account usage while the editor is open. When Claude is stopped, Turntrail also keeps its live and managed OAuth credentials synchronized and repairs a missing live login when the account identity is unambiguous. This makes background requests only to the configured OpenAI and Anthropic token and usage endpoints. API-key accounts are skipped."
        },
        "turntrail.accountMaintenance.intervalHours": {
          "type": "number",
          "scope": "application",
          "default": 5,
          "minimum": 1,
          "maximum": 24,
          "description": "Hours between background account maintenance runs. Timing is jittered to avoid simultaneous requests from several editor windows."
        },
        "contextBridge.maxExportChars": {
          "type": "number",
          "deprecationMessage": "Renamed to turntrail.maxExportChars. Existing values remain supported."
        },
        "contextBridge.sinceLastExport": {
          "type": "boolean",
          "deprecationMessage": "Renamed to turntrail.sinceLastExport. Existing values remain supported."
        },
        "contextBridge.dedupeTurns": {
          "type": "boolean",
          "deprecationMessage": "Renamed to turntrail.dedupeTurns. Existing values remain supported."
        },
        "contextBridge.toolMaxChars": {
          "type": "number",
          "deprecationMessage": "Renamed to turntrail.toolMaxChars. Existing values remain supported."
        },
        "contextBridge.systemMaxChars": {
          "type": "number",
          "deprecationMessage": "Renamed to turntrail.systemMaxChars. Existing values remain supported."
        },
        "contextBridge.snapshotDiffMaxChars": {
          "type": "number",
          "deprecationMessage": "Renamed to turntrail.snapshotDiffMaxChars. Existing values remain supported."
        },
        "contextBridge.keepExports": {
          "type": "number",
          "deprecationMessage": "Renamed to turntrail.keepExports. Existing values remain supported."
        },
        "contextBridge.openHandoffDocument": {
          "type": "boolean",
          "deprecationMessage": "Renamed to turntrail.openHandoffDocument. Existing values remain supported."
        },
        "contextBridge.claudeUri": {
          "type": "string",
          "scope": "application",
          "deprecationMessage": "Renamed to turntrail.claudeUri. Existing values remain supported."
        },
        "contextBridge.allowExternalClaudeUri": {
          "type": "boolean",
          "scope": "application",
          "deprecationMessage": "Renamed to turntrail.allowExternalClaudeUri. Existing values remain supported."
        },
        "contextBridge.claudeOpenCommand": {
          "type": "string",
          "scope": "application",
          "deprecationMessage": "Renamed to turntrail.claudeOpenCommand. Existing values remain supported."
        },
        "contextBridge.codexOpenCommand": {
          "type": "string",
          "scope": "application",
          "deprecationMessage": "Renamed to turntrail.codexOpenCommand. Existing values remain supported."
        },
        "contextBridge.alwaysUseLatestSession": {
          "type": "boolean",
          "deprecationMessage": "Renamed to turntrail.alwaysUseLatestSession. Existing values remain supported."
        }
      }
    },
    "menus": {
